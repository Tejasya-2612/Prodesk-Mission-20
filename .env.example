# Copy the component-specific file before running locally.
# Server settings are in server/.env.example; Vite settings are in client/.env.example.
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VITE_API_URL=http://localhost:4000/api
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASS=your-password
EMAIL_FROM=VaultPay <billing@example.com>
ADMIN_EMAIL=admin@vaultpay.demo
ADMIN_PASSWORD=ChangeThisDemoPassword123!
